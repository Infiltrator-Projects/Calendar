#!/usr/bin/make -f
# SPDX-License-Identifier: GPL-3.0-or-later
# Copyright (C) 1993-2026 Shannon Smith

CALENDAR_BUILD_MODE ?= generic
PGO_MODE ?= none
PGO_DIR ?= $(CURDIR)/.pgo-data
export CALENDAR_BUILD_MODE PGO_MODE PGO_DIR

ifeq ($(CALENDAR_BUILD_MODE),native)
DEB_BUILD_MAINT_OPTIONS := optimize=+lto
else
DEB_BUILD_MAINT_OPTIONS := optimize=-lto
endif
export DEB_BUILD_MAINT_OPTIONS

%:
	dh $@

override_dh_auto_build:
	$(MAKE) BUILD_MODE=$(CALENDAR_BUILD_MODE) all

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	$(MAKE) BUILD_MODE=$(CALENDAR_BUILD_MODE) \
		test validate-js validate-translations validate-sources \
		validate-package-inputs validate-release-model validate-architecture \
		validate-exports validate-abi validate-runtime-deps smoke-gjs
else
	@echo "Calendar source qualification already completed; skipping recursive package test pass."
endif

override_dh_auto_clean:
	$(MAKE) clean

override_dh_auto_install:
	rm -rf \
		"$(CURDIR)/debian/calendar" \
		"$(CURDIR)/debian/infiltrator-calendar-resources"
	$(MAKE) BUILD_MODE=$(CALENDAR_BUILD_MODE) install \
		'DESTDIR=$(CURDIR)/debian/calendar' PREFIX=/usr
	install -d \
		"$(CURDIR)/debian/infiltrator-calendar-resources/System/Resources/Calendars" \
		"$(CURDIR)/debian/infiltrator-calendar-resources/System/Resources/Clocks"
	mv "$(CURDIR)/debian/calendar/System/Resources/Calendars/"*.so \
		"$(CURDIR)/debian/infiltrator-calendar-resources/System/Resources/Calendars/"
	mv "$(CURDIR)/debian/calendar/System/Resources/Clocks/"*.so \
		"$(CURDIR)/debian/infiltrator-calendar-resources/System/Resources/Clocks/"
	rmdir --ignore-fail-on-non-empty \
		"$(CURDIR)/debian/calendar/System/Resources/Calendars" \
		"$(CURDIR)/debian/calendar/System/Resources/Clocks" \
		"$(CURDIR)/debian/calendar/System/Resources" \
		"$(CURDIR)/debian/calendar/System" || true
	@for resource in hebrew gregorian persian coptic; do \
		test -f "$(CURDIR)/debian/infiltrator-calendar-resources/System/Resources/Calendars/$$resource.so"; \
		test ! -e "$(CURDIR)/debian/calendar/System/Resources/Calendars/$$resource.so"; \
	done
	@for resource in decimal internet unix hexadecimal binary julian modified-julian standard-12 standard-24 chinese-ke mean-solar sidereal chinese-time solar italian-hours babylonian-hours babylonian-ancient indian-ghati; do \
		test -f "$(CURDIR)/debian/infiltrator-calendar-resources/System/Resources/Clocks/$$resource.so"; \
		test ! -e "$(CURDIR)/debian/calendar/System/Resources/Clocks/$$resource.so"; \
	done
