{
    "section1": {
        "type": "section",
        "description": "Display"
    },
    "theme-mode": {
        "type": "combobox",
        "default": "system",
        "description": "Theme",
        "options": {
            "Follow system": "system",
            "Day": "day",
            "Night": "night"
        },
        "tooltip": "Follow the current Cinnamon theme, or force Calendar to use its light or dark Infiltrator appearance."
    },
    "show-events": {
        "type": "switch",
        "default": true,
        "description": "Show calendar events",
        "tooltip": "Check this to display events in the calendar."
    },
    "show-week-numbers": {
        "type": "switch",
        "default": false,
        "description": "Show week numbers in calendar",
        "tooltip": "Check this to show week numbers in the calendar."
    },
    "section2": {
        "type": "section",
        "description": "Keyboard shortcuts"
    },
    "keyOpen": {
        "type": "keybinding",
        "description": "Show calendar",
        "default": "<Super>c",
        "tooltip": "Set keybinding(s) to show the calendar."
    }
}
